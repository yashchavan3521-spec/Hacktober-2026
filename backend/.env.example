# Copy to .env and set unique local credentials before starting the backend.
SOVA_USERNAME=replace-with-a-unique-username
SOVA_PASSWORD=replace-with-a-unique-password
SOVA_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Ollama defaults to the local machine. Pull the configured models before use.
OLLAMA_HOST=http://127.0.0.1:11434
SOVA_CHAT_MODEL=gemma3
SOVA_AGENT_MODEL=qwen2.5
SOVA_EMBED_MODEL=nomic-embed-text

# For a deployed frontend, add its exact origin (no trailing slash).
# SOVA_CORS_ORIGINS=https://your-project.vercel.app,https://your-custom-domain.example

# Optional override; defaults to the repository-root data/ directory
# SOVA_DATA_DIR=C:\path\to\sova-data
