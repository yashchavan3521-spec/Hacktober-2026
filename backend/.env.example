# Copy to .env and set unique local credentials before starting the backend.
SOVA_USERNAME=admin
SOVA_PASSWORD=replace-with-a-long-local-password
SOVA_JWT_SECRET=replace-with-at-least-32-random-characters

# Ollama defaults to the local machine. Pull the configured models before use.
OLLAMA_HOST=http://127.0.0.1:11434
SOVA_CHAT_MODEL=gemma3
SOVA_AGENT_MODEL=qwen2.5
SOVA_EMBED_MODEL=nomic-embed-text

# Optional override; defaults to the repository-root data/ directory
# SOVA_DATA_DIR=C:\path\to\sova-data
